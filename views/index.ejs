<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stream | pnpm + Redis</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
</head>
<body>
    <div class="hero-section text-center">
        <div class="container">
            <div class="d-inline-block p-2 px-3 rounded-pill bg-dark border border-secondary mb-3">
                <small class="text-uppercase tracking-wider fw-bold text-light" style="font-size: 0.7rem; letter-spacing: 1px;">
                    <i class="fas fa-bolt text-warning me-1"></i> Powered by pnpm & Redis
                </small>
            </div>
            <h1 class="display-3 mb-3">The <span class="text-gradient">Stream</span></h1>
            <p class="lead text-secondary mb-5 mx-auto" style="max-width: 600px;">
                A real-time ephemeral data stream running on Cloud Foundry. 
                Messages vanish. Visitors leave traces.
            </p>
        </div>
    </div>

    <div class="container pb-5">
        <div class="row g-5">
            <!-- Ephemeral Message Board -->
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h3 class="h5 mb-1 text-white"><i class="fas fa-fire text-danger me-2"></i>Flash Messages</h3>
                                <small class="text-secondary">Self-destructs in 60s</small>
                            </div>
                            <span class="badge bg-dark border border-secondary text-secondary">Live</span>
                        </div>

                        <form action="/message" method="POST" class="mb-4">
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 border-secondary text-secondary">
                                    <i class="fas fa-terminal"></i>
                                </span>
                                <input type="text" name="message" class="form-control border-start-0 ps-0" 
                                       placeholder="Drop a secret..." required autocomplete="off">
                                <button class="btn btn-primary" type="submit">
                                    Send <i class="fas fa-paper-plane ms-1"></i>
                                </button>
                            </div>
                        </form>

                        <div class="d-flex flex-column gap-3">
                            <% if (messages.length === 0) { %>
                                <div class="text-center py-5 rounded border border-dashed border-secondary opacity-50">
                                    <i class="fas fa-wind fa-2x mb-3 text-secondary"></i>
                                    <p class="mb-0 text-muted">Silence in the ether...</p>
                                </div>
                            <% } else { %>
                                <% messages.forEach(msg => { %>
                                    <div class="d-flex align-items-center justify-content-between p-3 rounded bg-dark border border-secondary">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="spinner-grow spinner-grow-sm text-danger" role="status"></div>
                                            <span class="fw-medium text-light"><%= msg.text %></span>
                                        </div>
                                        <span class="badge badge-ttl rounded-pill fw-normal">
                                            <i class="fas fa-hourglass-half me-1"></i> <%= msg.ttl %>s
                                        </span>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Visitor Log -->
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h3 class="h5 mb-1 text-white"><i class="fas fa-satellite-dish text-info me-2"></i>Signal Log</h3>
                                <small class="text-secondary">Last 10 detected signatures</small>
                            </div>
                            <div class="pulse text-success"><i class="fas fa-circle fa-xs"></i></div>
                        </div>

                        <div class="list-group list-group-flush">
                            <% visitors.forEach(visitor => { %>
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fas fa-microchip text-secondary"></i>
                                            <span class="text-light fw-medium"><%= visitor.ip %></span>
                                        </div>
                                        <small class="text-secondary"><%= visitor.time %></small>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <i class="fab fa-chrome text-muted" style="font-size: 0.8em;"></i>
                                        <small class="text-secondary text-truncate d-inline-block" style="max-width: 300px;">
                                            <%= visitor.userAgent %>
                                        </small>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="text-center">
        <div class="container">
            <p class="text-secondary mb-0">
                <small>Deployed on <span class="text-light">Cloud Foundry</span> &bull; 
                Built with <i class="fab fa-node-js text-success"></i> &bull; 
                Cached in <span class="text-danger">Redis</span></small>
            </p>
        </div>
    </footer>
    
    <script>
        // Smooth reload without full page blink
        async function refreshData() {
            try {
                const response = await fetch(window.location.href);
                const text = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(text, 'text/html');
                
                // Update specific containers only
                const newMessages = doc.querySelector('.col-lg-6:first-child .d-flex.flex-column');
                const newVisitors = doc.querySelector('.list-group');
                
                if (newMessages) document.querySelector('.col-lg-6:first-child .d-flex.flex-column').innerHTML = newMessages.innerHTML;
                if (newVisitors) document.querySelector('.list-group').innerHTML = newVisitors.innerHTML;
            } catch (e) {
                console.error("Auto-refresh failed", e);
            }
        }

        setInterval(refreshData, 5000);
    </script>
</body>
</html>
